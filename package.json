{
  "name": "smokia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "node scripts/build-verify.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:gemini": "node --experimental-strip-types --test tests/gemini-url-json.test.mjs",
    "test:leads": "node --experimental-strip-types --import ./tests/alias-register.mjs --test tests/lead-details.test.mjs tests/message-analysis.test.mjs",
    "test:automation": "node --experimental-strip-types --import ./tests/alias-register.mjs --test tests/automation-lead-planning.test.mjs tests/automation-leads-read.test.mjs tests/automation-create-lead.test.mjs tests/automation-admin.test.mjs",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "db:link": "supabase link",
    "db:diff": "supabase db diff --linked"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.48.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
