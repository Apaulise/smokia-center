# ── Supabase ────────────────────────────────────────────────────────────────
# Panel del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Saltea RLS. Sólo para el webhook de Apify y rutas de cron.
# NUNCA exponerla al cliente ni usarla en un Server Component.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cifrado de secretos de usuario ──────────────────────────────────────────
# 32 bytes en base64. Generar con:  openssl rand -base64 32
# Si se pierde, los tokens de Apify guardados quedan ilegibles y hay que recargarlos.
APP_ENCRYPTION_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# URL pública. Apify la usa para el webhook, así que en producción
# debe ser la URL real de Vercel, no localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/jobs/reconcile. Generar con:  openssl rand -hex 32
CRON_SECRET=

# ── Acceso ──────────────────────────────────────────────────────────────────
# Mails que pueden usar la app, separados por coma. Falla cerrado: sin esta
# variable no entra nadie (ni por contraseña ni por Google).
ALLOWED_EMAILS=vos@ejemplo.com,socio@ejemplo.com

# ── API de automatización (/api/automation/*) ───────────────────────────────
# Bearer token para n8n / scripts / agentes. Mínimo 32 caracteres; sin esta
# variable la API responde 401 a todo. Generar con:  openssl rand -hex 32
AUTOMATION_API_SECRET=
# UUID del usuario de Supabase dueño de los leads que ve y toca la API.
# Supabase → Authentication → Users → columna "UID" del mail correspondiente.
AUTOMATION_OWNER_ID=
# Quién puede usar /api/automation/admin/* (acceso total al CRM de ese owner).
# Lista separada por comas. Vacío = nadie. No cambia quién puede hacer el
# PATCH ni el alta históricos. Ejemplo: mr-pou
AUTOMATION_ADMIN_AGENTS=
